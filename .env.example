# ---------------------------------------------------------------------------
# RAILVYN environment configuration
# Copy to .env.local for local development, or configure in Vercel.
# Never commit real secrets. RAILVYN reads a single database variable:
# NEON_DATABASE_URL. No DATABASE_URL/DIRECT_URL fallback exists.
# ---------------------------------------------------------------------------

# Neon PostgreSQL connection string (required for live data).
# Use the pooled "-pooler" host for the Vercel runtime. RAILVYN disables
# prepared statements for pooler compatibility. The same variable is used by
# Drizzle Kit, migrations and scripts.
NEON_DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/railvyn?sslmode=require"

# Local embedded PostgreSQL equivalent:
# NEON_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/railvyn"

# Better Auth secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Public base URL of the application.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional secret for an expired-hold maintenance endpoint, when configured.
CRON_SECRET="replace-with-a-random-secret"

# Seat hold lifetime in seconds (default 300 = 5 minutes).
HOLD_TTL_SECONDS="300"

# Waitlist offer lifetime in seconds (default 600 = 10 minutes).
WAITLIST_OFFER_TTL_SECONDS="600"

# Maximum seats per booking (default 6).
MAX_SEATS_PER_BOOKING="6"

# Integration tests use the same NEON_DATABASE_URL variable, loaded from
# .env.test (never commit it). See .env.test.example.
