{
  "name": "railvyn",
  "version": "1.0.0",
  "private": true,
  "description": "RAILVYN — Railway Coach & Dynamic Seat Allocation System (independent demonstration project)",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "db:local": "tsx scripts/local-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "db:sql:export": "tsx scripts/export-seed-sql.ts",
    "db:sql:verify": "tsx scripts/verify-sql-files.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.16",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.7.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.9.0",
    "lucide-react": "^0.570.0",
    "next": "16.4.5",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.71.2",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@embedded-postgres/windows-x64": "18.6.0-beta.19",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.2.4",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
